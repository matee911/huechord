{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": []
  },
  // The bridge contract and the logger are shared with the UXP context on
  // purpose — one definition of the wire format, imported by both sides — so
  // they have to be part of this project too, not just resolvable from it.
  "include": [
    "./src",
    "../src/bridge",
    "../src/lib/logger.ts",
    "../src/algorithms/types.ts"
  ]
}
