{
  "name": "huechord",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "cross-env MODE=dev vite build --watch",
    "build": "cross-env MODE=build vite build",
    "ccx": "cross-env MODE=package vite build",
    "zip": "cross-env MODE=zip vite build",
    "preview": "vite preview",
    "hmr": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview-ui/tsconfig.json",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "quantize": "^1.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@adobe/cc-ext-uxp-types": "https://github.com/justintaylor-dev/cc-ext-uxp-types.git",
    "@amiceli/vitest-cucumber": "^7.0.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^20.8.7",
    "@types/photoshop": "^25.0.2",
    "@types/quantize": "^1.0.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.5.8",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "4.0.18",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "lint-staged": "^15.4.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "sass": "^1.69.5",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vite-uxp-plugin": "^1.2.5",
    "vitest": "^4.0.18",
    "ws": "^8.14.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,scss,css}": [
      "prettier --write"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged && yarn test:coverage",
    "pre-push": "sh scripts/reject-push-to-merged-branch.sh && yarn verify"
  }
}
